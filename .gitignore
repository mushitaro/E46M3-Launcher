# ── Secrets / machine-local ───────────────────────────────────────────────
# The keystore lives OUTSIDE this repo; these guard against an accidental copy.
*.jks
*.keystore
keystore.properties
local.properties

# The OTA manifest signing key also lives outside this repo (~/.e46m3/). These
# match the private half only: tools/ota_public_key.pem and the res/raw DER copy
# of it MUST be committed, or no car can verify anything.
*-private.pem
*private-key*.pem
ota.properties

# ── Gradle / Android build output ─────────────────────────────────────────
.gradle/
build/
app-launcher/.gradle/
app-launcher/build/
app-launcher/app/build/
# Kotlin compile daemon scratch + crash logs. Build noise, not source.
app-launcher/.kotlin/
.kotlin/
*.apk
*.aab
*.ap_
*.dex

# ── Device extraction (~126 MB, reproducible via adb) ─────────────────────
device-extract/

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
*.iml
.DS_Store
