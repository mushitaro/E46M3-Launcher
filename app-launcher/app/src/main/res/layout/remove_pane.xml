<?xml version="1.0" encoding="utf-8"?>
<!--
  Handing HOME back, so this launcher can be removed.

  ## Why it is opaque and the update pane is not

  The update pane is a place you can wander into. This is not: it is reached by
  a long press on the update pane's provenance line, it is the only screen in
  this app that can leave the unit without a home screen, and it should not look
  like somewhere you already were. Hence the same treatment as lost_home.xml —
  opaque, red headline, monospace for anything meant to be typed.

  ## The steps are shown before they are taken

  All four are on screen from the start, each with its own state mark, so the
  owner can see what is about to happen and where it got to if it stops. A
  procedure that reveals its next step only after the previous one has committed
  is how somebody ends up half way through this one in a garage with no laptop.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remove_pane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/d_screen"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/d_al_header_h"
        android:paddingStart="@dimen/d_al_pad_h"
        android:paddingEnd="@dimen/d_al_pad_h">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="@string/remove_title"
            android:textColor="@color/d_tach_red"
            android:textSize="@dimen/d_al_title_size"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.28"
            android:includeFontPadding="false" />

        <!-- Always reachable. Backing out of this is never refused: every step
             up to the last one is reversible with the command below. -->
        <FrameLayout
            android:id="@+id/remove_close"
            android:layout_width="@dimen/d_al_close_w"
            android:layout_height="@dimen/d_al_close_h"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/d_al_close"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/applist_close">

            <ImageView
                android:layout_width="@dimen/d_al_close_icon"
                android:layout_height="@dimen/d_al_close_icon"
                android:layout_gravity="center"
                android:src="@drawable/d_ic_home_solid"
                android:tint="@color/d_al_close_fg"
                android:contentDescription="@null" />
        </FrameLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/d_al_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/d_al_pad_h"
        android:paddingEnd="@dimen/d_al_pad_h"
        android:paddingTop="@dimen/d_ota_row_gap">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remove_warning"
            android:textColor="@color/d_al_badge_fg"
            android:textSize="@dimen/d_ota_detail_size"
            android:fontFamily="sans-serif-condensed"
            android:lineSpacingExtra="3px"
            android:includeFontPadding="false" />

        <!-- One line per step, rewritten in code with its state mark. -->
        <TextView
            android:id="@+id/remove_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_ota_row_gap"
            android:textColor="@color/d_al_name"
            android:textSize="@dimen/d_ota_note_size"
            android:fontFamily="monospace"
            android:lineSpacingExtra="5px"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/remove_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/d_ota_action_h"
            android:layout_marginTop="@dimen/d_ota_row_gap"
            android:minWidth="@dimen/d_ota_action_min_w"
            android:paddingStart="@dimen/d_ota_action_pad"
            android:paddingEnd="@dimen/d_ota_action_pad"
            android:background="@drawable/d_ota_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/d_al_title"
            android:textSize="@dimen/d_ota_action_size"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.18"
            android:includeFontPadding="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/d_al_row_rule" />

    <!-- On screen the whole time, not only after something has gone wrong. The
         moment these are needed is the moment this screen may be unreachable. -->
    <TextView
        android:id="@+id/remove_recovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/d_al_pad_h"
        android:paddingEnd="@dimen/d_al_pad_h"
        android:paddingTop="@dimen/d_ota_row_gap"
        android:paddingBottom="@dimen/d_ota_row_gap"
        android:textColor="@color/d_lit"
        android:textSize="@dimen/d_ota_foot_size"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:lineSpacingExtra="3px"
        android:includeFontPadding="false" />
</LinearLayout>
