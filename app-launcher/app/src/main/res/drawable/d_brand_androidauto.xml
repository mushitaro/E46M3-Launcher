<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android Auto mark.

  Path taken verbatim from Simple Icons' `androidauto.svg` (CC0 collection; the
  mark itself remains Google's). It is the real geometry rather than something
  drawn from memory, which is the whole point of sourcing it — a trademark that
  is subtly the wrong shape is worse than no trademark at all.

  Not generated by tools/svg_to_vector.py and deliberately named apart from the
  d_ic_* family, so re-running that script over the design file cannot overwrite
  it.

  Scaled to 0.86 about the centre: the source mark bleeds to all four edges of
  its 24-unit box, whereas the design's own key icons sit inside a ~2-unit
  margin. Without this it reads a size larger than its neighbours.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path
            android:fillColor="@color/d_icon"
            android:pathData="M12 0c-0.6 0-1.11 0.32-1.39 0.8L0.48 18.4a1.6 1.6 0 0 0 1.39 2.4h2l7.7-13.58 0.43-0.77 8.13 14.35h2a1.6 1.6 0 0 0 1.39-2.4L13.39 0.8A1.6 1.6 0 0 0 12 0zm0 7.47l-9.07 16 0.54 0.53L12 20.8l8.53 3.2 0.54-0.53z" />
    </group>
</vector>
