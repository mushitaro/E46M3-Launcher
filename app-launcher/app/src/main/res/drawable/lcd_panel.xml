<?xml version="1.0" encoding="utf-8"?>
<!--
  The LCD well. Its face is pure black — DEEPER than the #0A0A0D panel around it
  — so it reads as sunk below the surface rather than sitting on it. Once the
  carbon texture lands in Phase 2 that contrast is what sells the recess.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/m_slate_950" />
    <corners android:radius="4dp" />
    <stroke android:width="1dp" android:color="@color/m_border" />
</shape>
