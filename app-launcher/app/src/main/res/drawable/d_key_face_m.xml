<?xml version="1.0" encoding="utf-8"?>
<!--
  The M key. Identical geometry to its neighbours; only the fill differs.

  Design CSS:
    background: linear-gradient(180deg, #CE1533, #920A21)
    box-shadow: inset 0 1px 0 rgba(255,255,255,.2),
                inset 0 -1px 0 rgba(0,0,0,.4)
  pressed:
    background: linear-gradient(180deg, #B00E27, #7C081B)
    box-shadow: inset 0 2px 6px rgba(0,0,0,.6)

  Never animate this. It is a permanent brand mark, not a status: red at boot,
  red at idle, red whether the car is fine or not. A signal that never varies
  carries no information, which is exactly what keeps it from reading as an
  alarm — and motion is the channel that would break that.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/d_m_top_pressed"
                        android:endColor="@color/d_m_bottom_pressed"
                        android:type="linear" />
                    <corners android:radius="@dimen/d_key_r" />
                </shape>
            </item>
            <item android:height="2px" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#99000000" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/d_m_top"
                        android:endColor="@color/d_m_bottom"
                        android:type="linear" />
                    <corners android:radius="@dimen/d_key_r" />
                </shape>
            </item>
            <item android:height="1px" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="@color/d_m_hi" />
                </shape>
            </item>
            <item android:height="1px" android:gravity="bottom">
                <shape android:shape="rectangle">
                    <solid android:color="@color/d_m_lo" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
